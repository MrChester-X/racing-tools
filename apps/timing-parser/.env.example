# Supabase Postgres connection
# Dashboard -> Project Settings -> Database -> Connection string
# For a long-lived backend use the Session pooler (port 5432), NOT the Transaction pooler (6543):
# TypeORM uses prepared statements, which the transaction pooler does not support.
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<db-password>
DB_DATABASE=postgres

# Supabase requires SSL. Set to "false" only for local postgres without TLS.
DB_SSL=true

# Set to "true" to auto-run pending migrations on app startup.
DB_MIGRATIONS_RUN=false

PORT=3001
